# Ollama 配置（优先使用本地 LLM）
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b
OLLAMA_TIMEOUT=60

# 通义千问 API（备选方案）
# 获取 API Key: https://dashscope.console.aliyun.com/
TONGYI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# DeepSeek API（备选方案）
# 获取 API Key: https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 智谱 AI API
# 获取 API Key: https://open.bigmodel.cn/
ZHIPU_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ZHIPU_VISION_MODEL=glm-4.6v

# 腾讯混元视觉 API
# 获取 API Key: https://cloud.tencent.com/product/hunyuan
HUNYUAN_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
HUNYUAN_MODEL=hunyuan-vision

# API 超时设置（秒）
API_TIMEOUT=60

# 默认 LLM 选择
# tongyi - 通义千问
# zhipu - 智谱AI
# hunyuan - 腾讯混元
# ollama - 本地 Ollama
DEFAULT_LLM=zhipu

# 图片处理配置
MAX_IMAGE_SIZE=10485760  # 10MB
IMAGE_QUALITY=95

# 后端 API
BACKEND_API_URL=http://localhost:5001/api
